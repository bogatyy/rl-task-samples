# Archive-capable Ethereum mainnet RPC used only by Anvil.
ETH_RPC_URL=

# Archive-capable Base RPC used only by Anvil.
BASE_RPC_URL=

# Used by `cast source` for verified contract source retrieval.
ETHERSCAN_API_KEY=

# Required only for direct DeepSeek runs.
DEEPSEEK_API_KEY=

# Required only for OpenRouter runs.
OPENROUTER_API_KEY=
