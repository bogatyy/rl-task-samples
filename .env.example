# Preferred archive credential. The runner derives Alchemy's documented URL
# for the selected task chain and never exposes this key to model shell tools.
ALCHEMY_API_KEY=

# Optional explicit archive-RPC overrides used when ALCHEMY_API_KEY is unset.
ETH_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=
OPTIMISM_RPC_URL=
LINEA_RPC_URL=
BLAST_RPC_URL=
GNOSIS_RPC_URL=
MANTLE_RPC_URL=
SEI_RPC_URL=

# Used by `cast source` for verified contract source retrieval.
ETHERSCAN_API_KEY=

# Required only for direct DeepSeek runs.
DEEPSEEK_API_KEY=

# Required only for OpenRouter runs.
OPENROUTER_API_KEY=
